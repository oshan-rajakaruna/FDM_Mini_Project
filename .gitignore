# Python bytecode and caches
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# Notebook checkpoints
.ipynb_checkpoints/
.jupyter_runtime/
.matplotlib/

# IDE and operating-system files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local environment and secrets
.env
.env.*
!.env.example

# Packaging and coverage artifacts
build/
dist/
*.egg-info/
.coverage
htmlcov/

# Data artifacts: retain directory placeholders only
data/raw/*
data/interim/*
data/processed/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# Generated report artifacts: retain directory placeholders only
reports/figures/*
reports/tables/*
!reports/figures/.gitkeep
!reports/tables/.gitkeep
!reports/figures/missing_values/
!reports/figures/missing_values/*.png
!reports/figures/target_analysis/
!reports/figures/target_analysis/*.png
!reports/figures/relationships/
!reports/figures/relationships/*.png
!reports/figures/outliers/
!reports/figures/outliers/*.png
!reports/figures/leakage_split/
!reports/figures/leakage_split/*.png
!reports/figures/preprocessing/
!reports/figures/preprocessing/*.png
!reports/figures/feature_engineering/
!reports/figures/feature_engineering/*.png
!reports/tables/*.csv
