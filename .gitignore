# Python bytecode and caches
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# Notebook checkpoints
.ipynb_checkpoints/
.jupyter_runtime/

# IDE and operating-system files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local environment and secrets
.env
.env.*
!.env.example

# Packaging and coverage artifacts
build/
dist/
*.egg-info/
.coverage
htmlcov/

# Data artifacts: retain directory placeholders only
data/raw/*
data/interim/*
data/processed/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# Generated report artifacts: retain directory placeholders only
reports/figures/*
reports/tables/*
!reports/figures/.gitkeep
!reports/tables/.gitkeep
